# EcoPulse India Backend Environment Configuration
PORT=5000

# MongoDB Connection String
# For MongoDB Atlas (Recommended):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/econexus?retryWrites=true&w=majority
#
# For Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/econexus
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/econexus?retryWrites=true&w=majority
